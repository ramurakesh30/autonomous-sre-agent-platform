
local.file_match "order_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/order-service/*.jsonl",
      "job" = "order-service",
      "service" = "order-service",
    },
  ]
}

local.file_match "payment_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/payment-service/*.jsonl",
      "job" = "payment-service",
      "service" = "payment-service",
    },
  ]
}

loki.source.file "order_logs" {
  targets    = local.file_match.order_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.source.file "payment_logs" {
  targets    = local.file_match.payment_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
